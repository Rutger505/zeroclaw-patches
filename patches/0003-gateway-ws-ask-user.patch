+    #[tokio::test]
+    async fn ask_emits_question_and_returns_the_answer() {
+        let (tx, mut rx) = tokio::sync::mpsc::channel(8);
+        let pending = new_pending_approvals();
+        let channel = WsApprovalChannel::new(tx, Arc::clone(&pending), Duration::from_secs(30));
+
+        let call = async {
+            channel
+                .request_text("Discord user id?", Duration::from_secs(5))
+                .await
+        };
+        let answerer = async {
+            let Some(TurnEvent::AskUser {
+                request_id,
+                question,
+                choices,
+                timeout_secs,
+            }) = rx.recv().await
+            else {
+                panic!("expected an AskUser event");
+            };
+            assert_eq!(question, "Discord user id?");
+            assert!(choices.is_empty());
+            assert_eq!(timeout_secs, 5);
+            assert!(resolve_answer(&pending, &request_id, "1234".into()));
+        };
+        let (result, ()) = tokio::join!(call, answerer);
+        assert_eq!(result.unwrap().as_deref(), Some("1234"));
+        assert!(pending.lock().is_empty());
+    }
+
+    #[tokio::test]
+    async fn ask_times_out_with_an_error() {
+        let (tx, _rx) = tokio::sync::mpsc::channel(8);
+        let pending = new_pending_approvals();
+        let channel = WsApprovalChannel::new(tx, Arc::clone(&pending), Duration::from_secs(30));
+        let err = channel
+            .request_choice("pick", &["a".into(), "b".into()], Duration::from_millis(50))
+            .await
+            .expect_err("timeout is an error");
+        assert!(err.to_string().contains("No response"));
+        assert!(pending.lock().is_empty());
+    }
+
+    #[test]
+    fn answer_and_approval_ids_do_not_cross() {
+        let pending = new_pending_approvals();
+        let (atx, _arx) = oneshot::channel::<ChannelApprovalResponse>();
+        pending
+            .lock()
+            .insert("approval".into(), PendingReply::Approval(atx));
+        assert!(!resolve_answer(&pending, "approval", "x".into()));
+        assert!(pending.lock().contains_key("approval"));
+        let (qtx, _qrx) = oneshot::channel::<String>();
+        pending.lock().insert("question".into(), PendingReply::Answer(qtx));
+        assert!(!resolve_approval(
+            &pending,
+            "question",
+            ChannelApprovalResponse::Approve
+        ));
+        assert!(pending.lock().contains_key("question"));
+    }
