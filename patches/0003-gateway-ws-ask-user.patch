     ChannelApprovalResponse, ChannelMessage, SendMessage,
 };
 
+/// A parked prompt waiting for the client: a tool approval or an `ask_user`
+/// answer.
+pub enum PendingReply {
+    Approval(oneshot::Sender<ChannelApprovalResponse>),
+    Answer(oneshot::Sender<String>),
+}
+
 /// Shared map keyed by `request_id`. Consumed by the receive loop to resolve
-/// the oneshot when an `approval_response` frame arrives.
-pub type PendingApprovals = Arc<Mutex<HashMap<String, oneshot::Sender<ChannelApprovalResponse>>>>;
+/// the oneshot when an `approval_response` or `ask_user_response` frame
+/// arrives. Dropping an entry (detach) fails the waiter closed.
+pub type PendingApprovals = Arc<Mutex<HashMap<String, PendingReply>>>;
+
+/// Resolve a parked `ask_user` question. `false` when no question with that
+/// id is waiting (answered, timed out, or an approval id).
+pub fn resolve_answer(pending: &PendingApprovals, request_id: &str, answer: String) -> bool {
+    let mut guard = pending.lock();
+    if !matches!(guard.get(request_id), Some(PendingReply::Answer(_))) {
+        return false;
+    }
+    match guard.remove(request_id) {
+        Some(PendingReply::Answer(tx)) => tx.send(answer).is_ok(),
+        _ => false,
+    }
+}
+
+/// Resolve a parked tool approval. `false` when no approval with that id is
+/// waiting.
+pub fn resolve_approval(
+    pending: &PendingApprovals,
+    request_id: &str,
+    decision: ChannelApprovalResponse,
+) -> bool {
+    let mut guard = pending.lock();
+    if !matches!(guard.get(request_id), Some(PendingReply::Approval(_))) {
+        return false;
+    }
+    match guard.remove(request_id) {
+        Some(PendingReply::Approval(tx)) => tx.send(decision).is_ok(),
+        _ => false,
+    }
+}
 
 /// Construct an empty pending-approvals registry for a fresh connection.
 pub fn new_pending_approvals() -> PendingApprovals {
