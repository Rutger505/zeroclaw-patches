 impl WsApprovalChannel {
+    /// Park an `ask_user` question on the client and wait for its answer.
+    /// Timeout and a detached client are errors, so ask_user reports them
+    /// instead of treating them as "not handled".
+    async fn ask(
+        &self,
+        question: &str,
+        choices: &[String],
+        timeout: Duration,
+    ) -> anyhow::Result<String> {
+        let request_id = Uuid::new_v4().to_string();
+        let (tx, rx) = oneshot::channel();
+        self.pending
+            .lock()
+            .insert(request_id.clone(), PendingReply::Answer(tx));
+
+        let event = TurnEvent::AskUser {
+            request_id: request_id.clone(),
+            question: question.to_string(),
+            choices: choices.to_vec(),
+            timeout_secs: timeout.as_secs(),
+        };
+        if self.event_tx.send(event).await.is_err() {
+            self.pending.lock().remove(&request_id);
+            anyhow::bail!("WebSocket client is gone; nobody to ask");
+        }
+
+        match tokio::time::timeout(timeout, rx).await {
+            Ok(Ok(answer)) => Ok(answer),
+            Ok(Err(_)) => {
+                self.pending.lock().remove(&request_id);
+                anyhow::bail!("WebSocket client detached before answering")
+            }
+            Err(_) => {
+                self.pending.lock().remove(&request_id);
+                anyhow::bail!("No response received within {} seconds", timeout.as_secs())
+            }
+        }
+    }
+
