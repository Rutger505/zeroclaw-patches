+/// `{"type":"attach"}`: follow the turn running on this session from another
+/// socket (see `ws_turn_watch`). Sends `attached` (`running`, `turn_id`,
+/// `replayed`), the turn's frames so far, then the rest live up to its
+/// terminal frame. Read-only. Returns false once the client is gone.
+async fn attach_running_turn(
+    sender: &mut futures_util::stream::SplitSink<WebSocket, Message>,
+    receiver: &mut futures_util::stream::SplitStream<WebSocket>,
+    ping_interval: &mut Option<tokio::time::Interval>,
+    session_key: &str,
+) -> bool {
+    let Some(mut attached) = crate::ws_turn_watch::attach(session_key) else {
+        let frame = serde_json::json!({ "type": "attached", "running": false });
+        return sender.send(Message::Text(frame.to_string().into())).await.is_ok();
+    };
+    let head = serde_json::json!({
+        "type": "attached",
+        "running": true,
+        "turn_id": attached.turn_id,
+        "replayed": attached.replay.len(),
+    });
+    for frame in std::iter::once(head).chain(attached.replay.drain(..)) {
+        if sender.send(Message::Text(frame.to_string().into())).await.is_err() {
+            return false;
+        }
+    }
+    loop {
+        tokio::select! {
+            biased;
+            frame = attached.live.recv() => {
+                let Some(frame) = frame else { return true };
+                if sender.send(Message::Text(frame.to_string().into())).await.is_err() {
+                    return false;
+                }
+            }
+            client_msg = receiver.next() => match classify_client_frame(client_msg) {
+                ClientFrame::Gone => return false,
+                ClientFrame::Ping(payload) => {
+                    if sender.send(Message::Pong(payload)).await.is_err() {
+                        return false;
+                    }
+                }
+                ClientFrame::Ignore => {}
+                ClientFrame::Text(_) => {
+                    let err = serde_json::json!({
+                        "type": "error",
+                        "message": "attached to a turn another socket started: read-only until its done/aborted/error frame (abort: POST /api/sessions/{id}/abort)",
+                        "code": "ATTACHED_READ_ONLY"
+                    });
+                    if sender.send(Message::Text(err.to_string().into())).await.is_err() {
+                        return false;
+                    }
+                }
+            },
+            _ = tick_websocket_ping(ping_interval) => {
+                if sender.send(Message::Ping(Vec::new().into())).await.is_err() {
+                    return false;
+                }
+            }
+        }
+    }
+}
