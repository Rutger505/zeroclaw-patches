+//! Running `/ws/chat` turns that another socket can attach to.
+//!
+//! The socket that starts a turn is its only live viewer. Once it is gone (a
+//! client restart, a dropped connection) the turn keeps running but nobody
+//! sees its steps. Every frame a turn sends is also recorded here, so a new
+//! socket on the same session can send `{"type":"attach"}` and get the frames
+//! so far plus the rest live, ending with the terminal frame (`done`,
+//! `aborted` or `error`). Read-only: approvals, `ask_user` answers and steering
+//! stay with the socket that started the turn.
+
+use parking_lot::Mutex;
+use std::collections::HashMap;
+use std::sync::{Arc, OnceLock};
+use tokio::sync::mpsc;
+
+#[derive(Default)]
+struct Inner {
+    frames: Vec<serde_json::Value>,
+    watchers: Vec<mpsc::UnboundedSender<serde_json::Value>>,
+    ended: bool,
+}
+
+struct TurnWatch {
+    session_key: String,
+    turn_id: String,
+    inner: Mutex<Inner>,
+}
+
+type Registry = Mutex<HashMap<String, Arc<TurnWatch>>>;
+
+fn registry() -> &'static Registry {
+    static REGISTRY: OnceLock<Registry> = OnceLock::new();
+    REGISTRY.get_or_init(Registry::default)
+}
+
+/// Records one running turn; dropping it ends the turn for every watcher.
+pub struct TurnRecorder(Arc<TurnWatch>);
+
+/// Start recording the turn `turn_id` on `session_key` (one turn per session:
+/// the session permit serializes them).
+pub fn start(session_key: &str, turn_id: &str) -> TurnRecorder {
+    let watch = Arc::new(TurnWatch {
+        session_key: session_key.to_string(),
+        turn_id: turn_id.to_string(),
+        inner: Mutex::new(Inner::default()),
+    });
+    registry()
+        .lock()
+        .insert(session_key.to_string(), Arc::clone(&watch));
+    TurnRecorder(watch)
+}
+
+impl TurnRecorder {
+    /// A frame the turn sent (or would have sent) to its own socket.
+    pub fn record(&self, frame: &serde_json::Value) {
+        let mut inner = self.0.inner.lock();
+        inner.watchers.retain(|w| w.send(frame.clone()).is_ok());
+        // Streamed text arrives in many tiny deltas: keep one frame per run.
+        let kind = frame["type"].as_str();
+        if matches!(kind, Some("chunk" | "thinking"))
+            && let Some(last) = inner.frames.last_mut()
+            && last["type"].as_str() == kind
+            && let (Some(prev), Some(delta)) = (last["content"].as_str(), frame["content"].as_str())
+        {
+            last["content"] = serde_json::Value::String(format!("{prev}{delta}"));
+            return;
+        }
+        inner.frames.push(frame.clone());
+    }
+}
+
+impl Drop for TurnRecorder {
+    fn drop(&mut self) {
+        {
+            let mut registry = registry().lock();
+            if registry
+                .get(&self.0.session_key)
+                .is_some_and(|w| Arc::ptr_eq(w, &self.0))
+            {
+                registry.remove(&self.0.session_key);
+            }
+        }
+        let mut inner = self.0.inner.lock();
+        inner.ended = true;
+        // Closing the senders ends every watcher after the frames it has queued.
+        inner.watchers.clear();
+        inner.frames.clear();
+    }
+}
+
+pub struct Attached {
+    pub turn_id: String,
+    /// Frames the turn sent before the attach, streamed deltas merged.
+    pub replay: Vec<serde_json::Value>,
+    /// Frames after the attach; closed once the turn has ended.
+    pub live: mpsc::UnboundedReceiver<serde_json::Value>,
+}
+
+/// Follow the turn running on `session_key`, if any. Replay and live frames
+/// are taken under one lock: nothing is missed or sent twice.
+pub fn attach(session_key: &str) -> Option<Attached> {
+    let watch = registry().lock().get(session_key).cloned()?;
+    let mut inner = watch.inner.lock();
+    if inner.ended {
+        return None;
+    }
+    let (tx, live) = mpsc::unbounded_channel();
+    inner.watchers.push(tx);
+    Some(Attached {
+        turn_id: watch.turn_id.clone(),
+        replay: inner.frames.clone(),
+        live,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn ws_turn_watch_replays_then_streams_live_and_closes_at_the_end() {
+        let rec = start("gw_watch_a", "turn-1");
+        rec.record(&json!({"type": "chunk", "content": "Hel"}));
+        rec.record(&json!({"type": "chunk", "content": "lo"}));
+        rec.record(&json!({"type": "tool_call", "id": "t1", "name": "shell", "args": {}}));
+
+        let mut a = attach("gw_watch_a").expect("turn is running");
+        assert_eq!(a.turn_id, "turn-1");
+        assert_eq!(
+            a.replay,
+            vec![
+                json!({"type": "chunk", "content": "Hello"}),
+                json!({"type": "tool_call", "id": "t1", "name": "shell", "args": {}}),
+            ]
+        );
+
+        rec.record(&json!({"type": "tool_result", "id": "t1", "name": "shell", "output": "ok"}));
+        rec.record(&json!({"type": "done", "full_response": "Hello"}));
+        drop(rec);
+
+        assert_eq!(a.live.try_recv().unwrap()["type"], "tool_result");
+        assert_eq!(a.live.try_recv().unwrap()["type"], "done");
+        assert!(matches!(
+            a.live.try_recv(),
+            Err(mpsc::error::TryRecvError::Disconnected)
+        ));
+        assert!(attach("gw_watch_a").is_none(), "ended turn is gone");
+    }
+
+    #[test]
+    fn ws_turn_watch_no_running_turn() {
+        assert!(attach("gw_watch_none").is_none());
+    }
+
+    #[test]
+    fn ws_turn_watch_old_recorder_does_not_remove_a_newer_turn() {
+        let old = start("gw_watch_b", "turn-old");
+        let new = start("gw_watch_b", "turn-new");
+        drop(old);
+        assert_eq!(
+            attach("gw_watch_b").expect("newer turn").turn_id,
+            "turn-new"
+        );
+        drop(new);
+        assert!(attach("gw_watch_b").is_none());
+    }
+
+    #[test]
+    fn ws_turn_watch_does_not_merge_across_other_frames() {
+        let rec = start("gw_watch_c", "turn-1");
+        rec.record(&json!({"type": "thinking", "content": "a"}));
+        rec.record(&json!({"type": "chunk", "content": "b"}));
+        rec.record(&json!({"type": "thinking", "content": "c"}));
+        assert_eq!(attach("gw_watch_c").unwrap().replay.len(), 3);
+    }
+}
