+    fn sqlite_backend() -> (TempDir, Arc<dyn SessionBackend>) {
+        let tmp = TempDir::new().unwrap();
+        let backend =
+            zeroclaw_infra::session_sqlite::SqliteSessionBackend::new(tmp.path()).unwrap();
+        backend
+            .append("gw_alpha", &ChatMessage::user("Disk alert on the cluster"))
+            .unwrap();
+        backend
+            .append("gw_beta", &ChatMessage::user("Sync my Spotify playlist"))
+            .unwrap();
+        backend.set_session_name("gw_alpha", "Disk alert").unwrap();
+        (tmp, Arc::new(backend))
+    }
+
+    fn line_for<'a>(output: &'a str, key: &str) -> &'a str {
+        output
+            .lines()
+            .find(|line| line.starts_with(&format!("- {key}:")))
+            .unwrap_or_else(|| panic!("no line for {key} in {output}"))
+    }
+
+    #[tokio::test]
+    async fn sessions_list_shows_name() {
+        let (_tmp, backend) = sqlite_backend();
+        let tool = SessionsListTool::new(backend);
+        let result = tool.execute(json!({})).await.unwrap();
+        assert!(result.success);
+        assert!(result.output.contains("2 session(s)"));
+        assert!(line_for(&result.output, "gw_alpha").contains("name=\"Disk alert\", channel="));
+        assert!(!line_for(&result.output, "gw_beta").contains("name="));
+    }
+
+    #[tokio::test]
+    async fn sessions_list_query_returns_matches_with_name() {
+        let (_tmp, backend) = sqlite_backend();
+        let tool = SessionsListTool::new(backend);
+
+        let result = tool.execute(json!({"query": "cluster"})).await.unwrap();
+        assert!(result.success);
+        assert!(result.output.contains("1 session(s) matching 'cluster'"));
+        assert!(line_for(&result.output, "gw_alpha").contains("name=\"Disk alert\""));
+        assert!(!result.output.contains("gw_beta"));
+
+        let result = tool.execute(json!({"query": "spotify"})).await.unwrap();
+        assert!(result.output.contains("1 session(s) matching 'spotify'"));
+        assert!(result.output.contains("- gw_beta:"));
+        assert!(!result.output.contains("gw_alpha"));
+    }
+
+    #[tokio::test]
+    async fn sessions_list_query_without_match() {
+        let (_tmp, backend) = sqlite_backend();
+        let tool = SessionsListTool::new(backend);
+        let result = tool.execute(json!({"query": "kubernetes"})).await.unwrap();
+        assert!(result.success);
+        assert_eq!(&*result.output, "No sessions matching 'kubernetes'.");
+    }
+
