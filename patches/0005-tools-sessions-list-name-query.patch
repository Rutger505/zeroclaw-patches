From ae5ed1815895775b2845d24f041f7eb65ec8fc2f Mon Sep 17 00:00:00 2001
From: Rocky <rocky@zeroclaw>
Date: Sat, 14 Nov 2026 18:08:12 +0000
Subject: [PATCH 5/5] feat(tools): sessions_list shows session names and
 searches with query

sessions_list prints each session's name (session_metadata.name, the
thread title) and takes an optional query that full-text searches
sessions_fts via SessionBackend::search, returning only matching
sessions. Without query it lists as before.

SqliteSessionBackend::search now orders matches by last activity before
applying the limit (was arbitrary) and doubles embedded quotes so a word
with a quote no longer breaks the whole MATCH.
---
 crates/zeroclaw-infra/src/session_sqlite.rs |  43 ++++++-
 crates/zeroclaw-tools/src/sessions.rs       | 134 +++++++++++++++++---
 2 files changed, 154 insertions(+), 23 deletions(-)

diff --git a/crates/zeroclaw-infra/src/session_sqlite.rs b/crates/zeroclaw-infra/src/session_sqlite.rs
index e30bcd015..93c419133 100644
--- a/crates/zeroclaw-infra/src/session_sqlite.rs
+++ b/crates/zeroclaw-infra/src/session_sqlite.rs
@@ -1524,21 +1524,24 @@ impl SessionBackend for SqliteSessionBackend {
         #[allow(clippy::cast_possible_wrap)]
         let limit = query.limit.unwrap_or(50) as i64;
 
-        // FTS5 search
+        // FTS5 search, most recently active first (like list_sessions_with_metadata)
         let mut stmt = match conn.prepare(
-            "SELECT DISTINCT f.session_key
-             FROM sessions_fts f
-             WHERE sessions_fts MATCH ?1
+            "SELECT m.session_key
+             FROM session_metadata m
+             WHERE m.session_key IN
+                 (SELECT session_key FROM sessions_fts WHERE sessions_fts MATCH ?1)
+             ORDER BY m.last_activity DESC
              LIMIT ?2",
         ) {
             Ok(s) => s,
             Err(_) => return Vec::new(),
         };
 
-        // Quote each word for FTS5
+        // Quote each word for FTS5; an embedded quote is doubled, or the
+        // whole MATCH is a syntax error and nothing is found.
         let fts_query: String = keyword
             .split_whitespace()
-            .map(|w| format!("\"{w}\""))
+            .map(|w| format!("\"{}\"", w.replace('"', "\"\"")))
             .collect::<Vec<_>>()
             .join(" OR ");
 
@@ -1780,6 +1783,34 @@ mod tests {
         assert_eq!(results[0].key, "code_chat");
     }
 
+    #[test]
+    fn fts5_search_orders_by_activity_and_escapes_quotes() {
+        let tmp = TempDir::new().unwrap();
+        let backend = SqliteSessionBackend::new(tmp.path()).unwrap();
+
+        backend
+            .append("older", &ChatMessage::user("deploy the cluster"))
+            .unwrap();
+        std::thread::sleep(StdDuration::from_millis(50));
+        backend
+            .append("newer", &ChatMessage::user("deploy said \"done\""))
+            .unwrap();
+
+        let results = backend.search(&SessionQuery {
+            keyword: Some("deploy".into()),
+            limit: Some(10),
+        });
+        let keys: Vec<_> = results.iter().map(|m| m.key.as_str()).collect();
+        assert_eq!(keys, ["newer", "older"]);
+
+        let results = backend.search(&SessionQuery {
+            keyword: Some("\"done\"".into()),
+            limit: Some(10),
+        });
+        assert_eq!(results.len(), 1);
+        assert_eq!(results[0].key, "newer");
+    }
+
