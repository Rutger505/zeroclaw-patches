+        let tool = SessionsListTool::new(backend);
+        let result = tool.execute(json!({"query": "  "})).await.unwrap();
+        assert!(result.output.starts_with("Found 2 session(s):"));
+        assert!(tool.parameters_schema()["properties"]["query"].is_object());
