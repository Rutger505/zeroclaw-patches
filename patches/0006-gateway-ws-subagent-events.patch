+/// `subagent_event` frame: one step of a `spawn_subagent` run, tied to the
+/// parent's `tool_call` `id`. `event` is a `subagent_start`, a
+/// `tool_call`/`tool_result` shaped like the parent's, or a `subagent_end`.
+fn subagent_ws_frame(
+    parent_call_id: String,
+    step: zeroclaw_api::agent::SubagentStep,
+) -> Option<serde_json::Value> {
+    use zeroclaw_api::agent::SubagentStep;
+    let event = match step {
+        SubagentStep::Start { run_id } => {
+            serde_json::json!({ "type": "subagent_start", "run_id": run_id })
+        }
+        SubagentStep::Event(event) => tool_ws_frame(*event)?,
+        SubagentStep::End { success, error } => {
+            serde_json::json!({ "type": "subagent_end", "success": success, "error": error })
+        }
+    };
+    Some(serde_json::json!({
+        "type": "subagent_event",
+        "parent_call_id": parent_call_id,
+        "event": event,
+    }))
+}
