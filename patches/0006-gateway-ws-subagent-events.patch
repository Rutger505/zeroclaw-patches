+//! Live view of a `spawn_subagent` run for the parent's event stream.
+//!
+//! The parent turn's tool dispatch scopes a [`SubagentEventSink`] around a
+//! `spawn_subagent` call when it streams events. The child run executes in
+//! the same task, so its tool dispatch and the spawn tool find the sink and
+//! forward their steps as [`TurnEvent::Subagent`] keyed by the parent's
+//! call id. Without a sink (cron, non-streaming callers) nothing changes.
+
+use std::future::Future;
+use tokio::sync::mpsc::Sender;
+use zeroclaw_api::agent::{SubagentStep, TurnEvent};
+
+tokio::task_local! {
+    static SUBAGENT_EVENT_SINK: SubagentEventSink;
+}
+
+/// Parent event channel plus the `spawn_subagent` call id the steps belong to.
+#[derive(Clone)]
+pub struct SubagentEventSink {
+    parent_call_id: String,
+    tx: Sender<TurnEvent>,
+}
+
+impl SubagentEventSink {
+    pub fn new(parent_call_id: impl Into<String>, tx: Sender<TurnEvent>) -> Self {
+        Self {
+            parent_call_id: parent_call_id.into(),
+            tx,
+        }
+    }
+
+    /// The sink of the enclosing `spawn_subagent` call, if any.
+    pub fn current() -> Option<Self> {
+        SUBAGENT_EVENT_SINK.try_with(Clone::clone).ok()
+    }
+
+    pub async fn emit(&self, step: SubagentStep) {
+        let _ = self
+            .tx
+            .send(TurnEvent::Subagent {
+                parent_call_id: self.parent_call_id.clone(),
+                step,
+            })
+            .await;
+    }
+
+    /// Forward one of the child's own events.
+    pub async fn emit_event(&self, event: TurnEvent) {
+        self.emit(SubagentStep::Event(Box::new(event))).await;
+    }
+}
+
+/// Run `fut` with `sink` visible to [`SubagentEventSink::current`].
+pub async fn with_subagent_sink<F: Future>(sink: Option<SubagentEventSink>, fut: F) -> F::Output {
+    match sink {
+        Some(sink) => SUBAGENT_EVENT_SINK.scope(sink, fut).await,
+        None => fut.await,
+    }
+}
