diff --git a/crates/zeroclaw-runtime/src/agent/subagent_events.rs b/crates/zeroclaw-runtime/src/agent/subagent_events.rs
index 1b11e5d..f625a77 100644
--- a/crates/zeroclaw-runtime/src/agent/subagent_events.rs
