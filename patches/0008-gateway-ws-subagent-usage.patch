+/// Where a `TurnEvent::Usage` goes: the turn's own stream, or, in a
+/// `spawn_subagent` child run (which has no stream), the parent's stream as
+/// `SubagentStep::Event` so the parent turn's usage counts the child's calls.
+pub(crate) enum UsageSink<'a> {
+    Stream(&'a Sender<TurnEvent>),
+    Subagent(SubagentEventSink),
+}
+
+impl<'a> UsageSink<'a> {
+    /// `None` when nobody listens. A turn with its own stream never forwards.
+    pub(crate) fn resolve(event_tx: Option<&'a Sender<TurnEvent>>) -> Option<Self> {
+        match event_tx {
+            Some(tx) => Some(Self::Stream(tx)),
+            None => SubagentEventSink::current().map(Self::Subagent),
+        }
+    }
+
+    pub(crate) async fn send(&self, usage: TurnEvent) {
+        match self {
+            Self::Stream(tx) => {
+                let _ = tx.send(usage).await;
+            }
+            Self::Subagent(sink) => sink.emit_event(usage).await,
+        }
+    }
+}
+
 /// Run `fut` with `sink` visible to [`SubagentEventSink::current`].
 pub async fn with_subagent_sink<F: Future>(sink: Option<SubagentEventSink>, fut: F) -> F::Output {
     match sink {
@@ -57,3 +84,72 @@ pub async fn with_subagent_sink<F: Future>(sink: Option<SubagentEventSink>, fut:
         None => fut.await,
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn usage(accepted: bool) -> TurnEvent {
+        TurnEvent::Usage {
+            input_tokens: Some(10),
+            cached_input_tokens: None,
+            output_tokens: Some(2),
+            cost_usd: None,
+            context_token_budget: None,
+            model_context_window: None,
+            provider_ref: "test.default".into(),
+            model: "m".into(),
+            accepted,
+            estimated_input_tokens: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn subagent_usage_without_stream_goes_to_parent_sink() {
+        let (parent_tx, mut parent_rx) = tokio::sync::mpsc::channel(4);
+        let sink = SubagentEventSink::new("spawn-1", parent_tx);
+        with_subagent_sink(Some(sink), async {
+            let target = UsageSink::resolve(None).expect("parent sink in scope");
+            target.send(usage(false)).await;
+        })
+        .await;
+        match parent_rx.try_recv().expect("forwarded") {
+            TurnEvent::Subagent {
+                parent_call_id,
+                step: SubagentStep::Event(inner),
+            } => {
+                assert_eq!(parent_call_id, "spawn-1");
+                assert!(matches!(
+                    *inner,
+                    TurnEvent::Usage {
+                        accepted: false,
+                        ..
+                    }
+                ));
+            }
+            other => panic!("expected subagent usage, got {other:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn subagent_usage_own_stream_wins_and_is_not_double_sent() {
+        let (parent_tx, mut parent_rx) = tokio::sync::mpsc::channel(4);
+        let (own_tx, mut own_rx) = tokio::sync::mpsc::channel(4);
+        let sink = SubagentEventSink::new("spawn-1", parent_tx);
+        with_subagent_sink(Some(sink), async {
+            let target = UsageSink::resolve(Some(&own_tx)).expect("own stream");
+            target.send(usage(true)).await;
+        })
+        .await;
+        assert!(matches!(
+            own_rx.try_recv(),
+            Ok(TurnEvent::Usage { accepted: true, .. })
+        ));
+        assert!(parent_rx.try_recv().is_err(), "no copy to the parent sink");
+    }
+
+    #[tokio::test]
+    async fn subagent_usage_dropped_without_stream_or_sink() {
+        assert!(UsageSink::resolve(None).is_none());
+    }
+}
