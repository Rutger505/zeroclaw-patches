+        let dir = tmp.path().join("app");
+        std::fs::create_dir_all(&dir).unwrap();
+        let skill_md = dir.join("SKILL.md");
+        std::fs::write(
+            &skill_md,
+            format!(
+                "---\nname: app\ndescription: d\nrepo_docs: {}\n---\nskill body\n",
+                doc.display()
+            ),
+        )
+        .unwrap();
+        let skill = load_skill_md(&skill_md, &dir).unwrap();
+        assert_eq!(skill.prompts, vec!["skill body\n".to_string()]);
+
+        let full = skills_to_prompt_with_mode(
+            std::slice::from_ref(&skill),
+            tmp.path(),
+            zeroclaw_config::schema::SkillsPromptInjectionMode::Full,
+        );
+        assert!(full.contains("skill body"), "{full}");
+        assert!(full.contains("--- repo docs: "), "{full}");
+        assert!(full.contains("repo rules here"), "{full}");
+
+        let compact = skills_to_prompt_with_mode(
+            std::slice::from_ref(&skill),
+            tmp.path(),
+            zeroclaw_config::schema::SkillsPromptInjectionMode::Compact,
+        );
+        assert!(!compact.contains("repo rules here"), "{compact}");
+    }
