+/// Contents of the `repo_docs` files a SKILL.md declares, formatted to append
+/// after its body: `\n\n--- repo docs: <path> ---\n<content>` per file, or a
+/// `(not found)` line when unreadable. Files are read on every call so repo
+/// edits show up live. Empty without `repo_docs`.
+pub fn repo_docs_appendix(skill_markdown: &str) -> String {
+    use std::fmt::Write;
+
+    let mut out = String::new();
+    for path in parse_skill_markdown(skill_markdown).meta.repo_docs {
+        match std::fs::read_to_string(shellexpand::tilde(&path).as_ref()) {
+            Ok(content) => {
+                let _ = write!(out, "\n\n--- repo docs: {path} ---\n{content}");
+            }
+            Err(_) => {
+                let _ = write!(out, "\n\n--- repo docs: {path} (not found) ---");
+            }
+        }
+    }
+    out
+}
+
+/// [`repo_docs_appendix`] for a loaded skill, re-reading its SKILL.md.
+fn skill_repo_docs_appendix(skill: &Skill) -> String {
+    skill
+        .location
+        .as_deref()
+        .filter(|path| {
+            path.extension()
+                .is_some_and(|ext| ext.eq_ignore_ascii_case("md"))
+        })
+        .and_then(|path| std::fs::read_to_string(path).ok())
+        .map(|content| repo_docs_appendix(&content))
+        .unwrap_or_default()
+}
