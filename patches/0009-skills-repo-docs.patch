+    #[test]
+    fn repo_docs_frontmatter_accepts_string_and_list() {
+        let single = parse_simple_frontmatter("name: x\nrepo_docs: ~/Source/app/AGENTS.md\n");
+        assert_eq!(single.repo_docs, vec!["~/Source/app/AGENTS.md"]);
+
+        let list = parse_simple_frontmatter(
+            "name: x\nrepo_docs:\n  - ~/a/AGENTS.md\n  - \"/b/CLAUDE.md\"\ntags:\n  - t\n",
+        );
+        assert_eq!(list.repo_docs, vec!["~/a/AGENTS.md", "/b/CLAUDE.md"]);
+        assert_eq!(list.tags, vec!["t"]);
+
+        let inline = parse_simple_frontmatter("repo_docs: [/a.md, '/b.md']\n");
+        assert_eq!(inline.repo_docs, vec!["/a.md", "/b.md"]);
+
+        assert!(parse_simple_frontmatter("name: x\n").repo_docs.is_empty());
+    }
+
+    #[test]
+    fn repo_docs_appendix_reads_files_and_notes_missing() {
+        let tmp = tempfile::tempdir().unwrap();
+        let doc = tmp.path().join("AGENTS.md");
+        std::fs::write(&doc, "repo rules v1\n").unwrap();
+        let missing = tmp.path().join("missing.md");
+        let md = format!(
+            "---\nname: x\nrepo_docs:\n  - {}\n  - {}\n---\nbody\n",
+            doc.display(),
+            missing.display()
+        );
+
+        assert_eq!(
+            repo_docs_appendix(&md),
+            format!(
+                "\n\n--- repo docs: {} ---\nrepo rules v1\n\n\n--- repo docs: {} (not found) ---",
+                doc.display(),
+                missing.display()
+            )
+        );
+        // Read on every call: edits show up without reloading the skill.
+        std::fs::write(&doc, "repo rules v2\n").unwrap();
+        assert!(repo_docs_appendix(&md).contains("repo rules v2"));
+        assert!(repo_docs_appendix("---\nname: x\n---\nbody\n").is_empty());
+    }
+
